{
  "name": "skylot-server",
  "version": "1.2.2",
  "description": "SKYLOT Auction — server version (Node.js + PostgreSQL)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "admin": "node --env-file=.env scripts/create-admin.js",
    "import": "node --env-file=.env scripts/import-backup.js",
    "test": "node --test test/security.test.js",
    "mock": "node test/mock/server.js",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "argon2": "^0.40.3",
    "fastify": "^4.28.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}